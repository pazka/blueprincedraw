{
  "name": "blueprincedraw",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Excalidraw for humongous boards: folder or server storage, streamed imports, no single-string limits",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-assets.mjs && tsc -b && vite build && node scripts/precompress.mjs",
    "start": "node server/main.js",
    "test": "node --test \"test/**/*.test.*\"",
    "smoke": "node server/smoke.js",
    "preview": "vite preview --port 4270"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
