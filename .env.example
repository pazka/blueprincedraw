# blueprincedraw environment. Copy to blueprincedraw.env (chmod 600). Nothing secret here:
# the app stores nothing and has no login; boards live only in each visitor's browser.
# required:
# (no owner secret is needed)

# --- deployment ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/blueprincedraw:v1.0.1'
APP_BIND='127.0.0.1:9132'

# --- app ---
APP_LOG_LEVEL='info'
